# Copy to .env and edit. .env is ignored by git and must never be committed.

# Tally XML server
TALLY_HOST=localhost
TALLY_PORT=9000
# Milliseconds to wait for a reply from Tally
TALLY_TIMEOUT=120000

# Set to 1 to hide the write tools completely
BLOCK_WRITE=0

# --- Remote (HTTP) deployment only ---

PORT=3000
# The public URL of this server. Used as the OAuth issuer and to decide which
# Host headers the MCP endpoint accepts.
MCP_DOMAIN=http://localhost:3000

# Password for the OAuth consent page. The server refuses to start on a
# non-local MCP_DOMAIN while this is left at the default of "password".
PASSWORD=change-me

# Set to 1 only if you deliberately want the default password on a public domain
# ALLOW_DEFAULT_PASSWORD=0

# Set to 1 when running behind a reverse proxy, so rate limiting sees the real
# client address from X-Forwarded-For rather than the proxy's
# TRUST_PROXY=0

# --- Multiple Tally users on one machine ---

# Set to 1 to serve one profile per Tally user at /u/<id>/mcp. Each profile has
# its own Tally port, password and token, and the unprefixed routes are switched
# off. The Windows installer sets this.
# MULTI_USER=0

# Where the profile registry and the admin token are kept. Defaults to
# %ProgramData%\TallyMcpServer on Windows and ~/.tally-mcp-server elsewhere.
# TALLY_MCP_DATA_DIR=

# Address the HTTP server binds to. Set 127.0.0.1 to accept connections from
# this machine only. The default listens on every interface.
# BIND_HOST=0.0.0.0
