{
  "name": "tally-mcp-server",
  "version": "7.6.0",
  "description": "Tally Prime MCP (Model Context Protocol) Server implementation to feed Tally Prime ERP data to popular LLM like Claude, ChatGPT supporting MCP",
  "type": "module",
  "main": "dist/server.mjs",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build:templates": "node scripts/build-templates.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "build": "pnpm build:templates && tsc && pnpm build:manifest",
    "check": "tsc --noEmit && node scripts/build-manifest.mjs --check",
    "start": "node dist/server.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhananjay1405/tally-mcp-server.git"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/dhananjay1405/tally-mcp-server/issues"
  },
  "homepage": "https://github.com/dhananjay1405/tally-mcp-server#readme",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "nunjucks": "^3.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/emscripten": "^1.41.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/nunjucks": "^3.2.6",
    "typescript": "^7.0.2"
  }
}
